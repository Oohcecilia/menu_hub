{
  "name": "Product",
  "type": "object",
  "properties": {
    "name_en": {
      "type": "string",
      "description": "Product name in English"
    },
    "name_es": {
      "type": "string",
      "description": "Product name in Spanish"
    },
    "name_fil": {
      "type": "string",
      "description": "Product name in Filipino"
    },
    "description_en": {
      "type": "string",
      "description": "Description in English"
    },
    "description_es": {
      "type": "string",
      "description": "Description in Spanish"
    },
    "description_fil": {
      "type": "string",
      "description": "Description in Filipino"
    },
    "price": {
      "type": "number",
      "description": "Base price in local currency"
    },
    "category_id": {
      "type": "string",
      "description": "Reference to Category"
    },
    "branch_ids": {
      "type": "array",
      "description": "Which branches sell this product. Empty = all branches.",
      "items": {
        "type": "string"
      }
    },
    "images": {
      "type": "array",
      "description": "Array of image URLs",
      "items": {
        "type": "string"
      }
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "is_popular": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number"
    },
    "option_groups": {
      "type": "array",
      "description": "Groups of selectable options (e.g. crust, size, extras)",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "multiple": {
            "type": "boolean",
            "default": false
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "price_add": {
                  "type": "number",
                  "default": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "name_en",
    "price",
    "category_id"
  ]
}